#!/bin/bash
#SBATCH --job-name=a2_part2
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=18
#SBATCH --time=04:00:00
#SBATCH --output=a2_part2_%j.out

# Run from the folder that contains Assignment_2_part2.ipynb and Eindhoven_centraal_platform_3_4.png:
#   sbatch run_part2.job
# The first run creates a Python environment in ~/venvs/ml4sci (a few minutes).

module purge
module load 2024
module load Python/3.12.3-GCCcore-13.3.0

if [ ! -d "$HOME/venvs/ml4sci" ]; then
    python -m venv "$HOME/venvs/ml4sci"
    source "$HOME/venvs/ml4sci/bin/activate"
    pip install --upgrade pip
    pip install torch torch_geometric lightning gdown matplotlib numpy jupyter nbconvert ipykernel
else
    source "$HOME/venvs/ml4sci/bin/activate"
fi

nvidia-smi

# Executes every cell and saves the outputs (metrics, plots) into the notebook itself
jupyter nbconvert --to notebook --execute --inplace \
    --ExecutePreprocessor.timeout=-1 --ExecutePreprocessor.kernel_name=python3 \
    Assignment_2_part2.ipynb
